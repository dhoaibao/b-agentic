{
  "mcpServers": {
    "clickup": {
      "description": "ClickUp tasks, documents, and time entries; writes ask first.",
      "command": "npx",
      "args": ["-y", "@hauptsache.net/clickup-mcp@1.9.0"],
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}"
      },
      "directTools": "search",
      "lifecycle": "lazy"
    }
  }
}
