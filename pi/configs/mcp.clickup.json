{
  "mcpServers": {
    "clickup": {
      "command": "npx",
      "args": ["-y", "@hauptsache.net/clickup-mcp@1.9.0"],
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}"
      },
      "directTools": [
        "getTaskById",
        "searchTasks",
        "readDocument",
        "getListInfo",
        "searchSpaces",
        "getTimeEntries",
        "read_space_clickup_space_txt"
      ],
      "lifecycle": "lazy"
    }
  }
}
