#!/bin/sh
# Pi entry point for b-candidate-snapshot.mjs, run by Node, which Pi itself needs (ADR-030).
# The printed commands name this folder, and a Pi session id replaces an inherited Claude Code one
# so the lock owner is the Pi session.
# shellcheck disable=SC2088 # The helpers print this folder as the literal text ~/..., never expanded.
B_AGENTIC_HELPER_DIR='~/.pi/agent/b-agentic/bin'
export B_AGENTIC_HELPER_DIR
if [ -n "${PI_SESSION_ID:-}" ]; then unset CLAUDE_CODE_SESSION_ID; fi
exec node "${0%/*}/b-candidate-snapshot.mjs" "$@"
