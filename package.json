{
  "name": "@dhoaibao/b-agentic-dev-tools",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "quality": "bash scripts/quality-check.sh"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "**/*.py": [
      "ruff check",
      "ruff format --check"
    ],
    "**/*.{sh,bash}": [
      "shellcheck --shell=bash --external-sources"
    ],
    "**/*.md": [
      "prettier --check",
      "markdownlint-cli2"
    ],
    "**/*.{json,jsonc,yaml,yml}": [
      "prettier --check"
    ]
  }
}
