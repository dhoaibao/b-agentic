{
  "name": "@dhoaibao/b-agentic-dev-tools",
  "private": true,
  "scripts": {
    "prepare": "bun node_modules/.bin/husky",
    "quality": "bash scripts/quality-check.sh"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1"
  },
  "lint-staged": {
    "**/*.py": [
      "ruff check",
      "ruff format --check"
    ],
    "**/*.{sh,bash}": [
      "shellcheck --shell=bash --external-sources"
    ],
    "**/*.md": [
      "bun node_modules/.bin/prettier --check",
      "bun node_modules/.bin/markdownlint-cli2"
    ],
    "**/*.{js,mjs,ts}": [
      "bun node_modules/.bin/prettier --check"
    ],
    "**/*.{json,jsonc,yaml,yml}": [
      "bun node_modules/.bin/prettier --check"
    ]
  }
}
