    decision = "prompt",
    justification = "b-agentic asks before a push or a GitHub state change",
    match = [["gh", "repo", "fork"]],
)

prefix_rule(
    pattern = ["rtk", "gh", "repo", "fork"],
    decision = "prompt",
    justification = "b-agentic asks before a push or a GitHub state change",
    match = [["rtk", "gh", "repo", "fork"]],
)

