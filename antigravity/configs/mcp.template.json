{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "brave_search": {
      "command": "bunx",
      "args": [
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "firecrawl": {
      "command": "bunx",
      "args": [
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp",
        "--isolated",
        "--headless",
        "--caps=testing"
      ]
    },
    "notion": {
      "serverUrl": "https://mcp.notion.com/mcp"
    },
    "excalidraw": {
      "serverUrl": "https://mcp.excalidraw.com"
    },
    "drawio": {
      "command": "bunx",
      "args": [
        "@drawio/mcp@1.6.3"
      ],
      "env": {
        "DRAWIO_ICON_SERVICE_URL": "off"
      }
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
