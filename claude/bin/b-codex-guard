#!/bin/sh
# Short entry point for the secret preflight, hooks/b-codex-guard.mjs --check (ADR-028). The installer swaps
# the bare bun below for the absolute path it found; the flags stop a repository's bunfig.toml and .env
# from loading (ADR-018).
exec bun --no-env-file --config=/dev/null "${0%/*}/../hooks/b-codex-guard.mjs" "$@"
