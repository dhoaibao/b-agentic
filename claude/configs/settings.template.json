            "command": "node \"$HOME/.claude/b-agentic/hooks/b-codex-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__clickup__createTask|mcp__clickup__updateTask",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-clickup-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-verify-gate.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-verify-gate.mjs\""
          }
        ]
      }
    ]
  }
