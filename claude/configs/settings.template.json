          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-path-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-codex-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-verify-gate.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/b-agentic/hooks/b-verify-gate.mjs\""
