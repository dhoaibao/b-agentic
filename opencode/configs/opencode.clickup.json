{
  "mcp": {
    "servers": {
      "clickup": {
        "type": "local",
        "command": [
          "bunx",
          "@hauptsache.net/clickup-mcp@1.9.0"
        ],
        "environment": {
          "CLICKUP_API_KEY": "{env:CLICKUP_API_KEY}",
          "CLICKUP_TEAM_ID": "{env:CLICKUP_TEAM_ID}"
        },
        "disabled": false,
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000
        }
      }
    }
  }
}
